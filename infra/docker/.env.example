# Copy this file to infra/docker/.env, then replace every placeholder. Never commit .env.
POSTGRES_USER=home_media
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=home_media
DATABASE_URL=postgresql+psycopg://home_media:replace-with-a-long-random-password@postgres:5432/home_media
REDIS_URL=redis://redis:6379/0

APP_ENVIRONMENT=production
INTERNAL_API_TOKEN=replace-with-a-long-random-token
AUTOMATION_WEBHOOK_TOKEN=replace-with-a-long-random-token
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_ALLOWED_USER_IDS=replace-with-your-numeric-telegram-user-id

LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
# `gemini-flash-latest` is verified against the Gemini Developer API.
GEMINI_MODEL=gemini-flash-latest
# Enable only when the Gemini project has Google Search grounding quota.
GEMINI_GOOGLE_SEARCH_ENABLED=false
MEDIA_MARKET_COUNTRY=US
CHAT_HISTORY_LIMIT=20

AUTOMATION_PROVIDER=mock
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
# Set AUTOMATION_PROVIDER=arr only after initial service setup. API keys are
# server-side only; Gemini never receives them.
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=
# Normal deployment: qBittorrent has its own service network address. The VPN
# override switches its network namespace to Gluetun while retaining port 8080.
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
MEDIA_ROOT_FOLDER=/data/library
RADARR_ROOT_FOLDER=/data/library/movies
SONARR_ROOT_FOLDER=/data/library/tv
LIDARR_ROOT_FOLDER=/data/library/music
# New movie and TV requests use this 720p-only Arr profile by default.
RADARR_QUALITY_PROFILE=HD-720p
SONARR_QUALITY_PROFILE=HD-720p
# Create this restricted Postgres login during deployment; it must not use the
# application owner password.
CHAT_READER_DATABASE_URL=
CHAT_SQL_TIMEOUT_MS=3000
CHAT_SQL_ROW_LIMIT=25
TZ=Europe/Zurich
PUID=1000
PGID=1000
# On Ubuntu, use absolute mounted-storage paths.
CONFIG_ROOT=/srv/home-media/config
MEDIA_ROOT=/srv/media
# The host firewall, not Docker, restricts this port to NordVPN Meshnet.
JELLYFIN_BIND_ADDRESS=0.0.0.0
# Needed only when starting with docker-compose.vpn.yml. The standard stack
# uses the host NordVPN connection instead.
NORDVPN_SERVICE_PROVIDER=nordvpn
NORDVPN_PRIVATE_KEY=
NORDVPN_COUNTRIES=Switzerland
