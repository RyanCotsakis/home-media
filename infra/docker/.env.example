# Copy this file to infra/docker/.env, then replace every placeholder. Never commit .env.
POSTGRES_USER=home_media
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=home_media
DATABASE_URL=postgresql+psycopg://home_media:replace-with-a-long-random-password@postgres:5432/home_media
REDIS_URL=redis://redis:6379/0

APP_ENVIRONMENT=production
INTERNAL_API_TOKEN=replace-with-a-long-random-token
AUTOMATION_WEBHOOK_TOKEN=replace-with-a-long-random-token
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_ALLOWED_USER_IDS=replace-with-your-numeric-telegram-user-id

LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
# `gemini-flash-latest` is verified against the Gemini Developer API.
GEMINI_MODEL=gemini-flash-latest
# Enable only when the Gemini project has Google Search grounding quota.
GEMINI_GOOGLE_SEARCH_ENABLED=false
MEDIA_MARKET_COUNTRY=US
CHAT_HISTORY_LIMIT=20

AUTOMATION_PROVIDER=mock
JELLYFIN_URL=http://jellyfin:8096
TZ=Europe/Zurich
PUID=1000
PGID=1000
# On Ubuntu, use absolute mounted-storage paths.
CONFIG_ROOT=/srv/home-media/config
MEDIA_ROOT=/srv/media
# The host firewall, not Docker, restricts this port to NordVPN Meshnet.
JELLYFIN_BIND_ADDRESS=0.0.0.0
NORDVPN_SERVICE_PROVIDER=nordvpn
NORDVPN_PRIVATE_KEY=replace-with-your-nordvpn-wireguard-private-key
NORDVPN_COUNTRIES=Switzerland
